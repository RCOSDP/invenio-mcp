# docker-compose.yml 用。cp .env.example .env して編集する。

# --- 認証方式 ---------------------------------------------------------------
# invenio  … InvenioRDM の個人アクセストークン(PAT)を Bearer でそのまま受ける（既定）
# keycloak … MCP 2026-07-28 の認可（OAuth 2.1 + PKCE + RFC 8707 + RFC 8693 交換）
MCP_AUTH_MODE=invenio

# --- 接続先 InvenioRDM ------------------------------------------------------
INVENIO_API=https://jc2.localhost/api
INVENIO_UI=https://jc2.localhost

# 自己署名なら CA のパス（compose ファイルからの相対 or 絶対）。既定は ./ca.crt。
# 公的証明書なら compose 側の volumes 行ごと消す。
CA_FILE=./ca.crt

# --- canonical URI ----------------------------------------------------------
# **クライアントが実際に叩く URL と一字一句同じにすること。**
MCP_RESOURCE=http://127.0.0.1:9100/mcp

# --- PAT モードのロール→scope ----------------------------------------------
# 認証できた全員に与える scope
MCP_INVENIO_BASE_SCOPES=mcp:read mcp:write
# このロールを持つ利用者にだけ mcp:curate（公開レコードの取り下げ・復元）を与える。
# カンマ区切りで複数指定できる。
MCP_INVENIO_CURATE_ROLES=admin
# /me による検証結果を保持する秒数
MCP_INVENIO_VERIFY_TTL=60

# --- keycloak モードのときだけ必要 ------------------------------------------
#KC_ISSUER=https://keycloak.jc2.localhost/realms/mcp
#MCP_SERVER_SECRET=
